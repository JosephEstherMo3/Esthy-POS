# Copy this file to `.env` (never commit `.env`).

# PostgreSQL connection string used by the server only (never exposed to the browser).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Canonical HTTPS origin used for password-reset links in production.
APP_URL=https://pos.example.com

# Configure ONE email provider. Resend takes priority when both are configured.
# Option A: Resend (https://resend.com) — verify your sending domain and API key first.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM="Charlotte Esthy <no-reply@your-verified-domain.com>"

# Option B: SMTP (port 587 uses STARTTLS; port 465 uses implicit TLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password-or-app-password
# EMAIL_FROM="Charlotte Esthy <no-reply@your-domain.com>"
# Optional override if your SMTP provider requires a different sender address:
# SMTP_FROM="Charlotte Esthy <no-reply@your-domain.com>"

